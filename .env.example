# -----------------------------------------------------------------------------
# Configuração do ambiente EVE-NG em Docker
# Copie para .env e ajuste:   cp .env.example .env
# -----------------------------------------------------------------------------

# Imagem do container que roda o QEMU/KVM
QEMU_IMAGE=qemux/qemu:latest

# --- Recursos da VM do EVE-NG ------------------------------------------------
# Ubuntu Server sem interface gráfica usa pouca RAM: reserve 2 a 3 GB e
# 1 núcleo para ele e entregue o resto ao EVE-NG.
#   Servidor com 16 GB  -> EVE_RAM=14G  (labs pequenos a médios)
#   Servidor com 32 GB  -> EVE_RAM=29G  (folga para CCNA + FortiGate)
#   Servidor com 64 GB  -> EVE_RAM=61G
# O comando "make check" sugere os valores para o seu servidor.
EVE_RAM=16G
EVE_CPUS=8

# Tamanho máximo do disco virtual. O arquivo cresce conforme o uso.
EVE_DISK=300G

# Pasta onde o disco da VM é salvo (use um caminho no HD de 1 TB)
EVE_DATA_DIR=./data

# Caminho da ISO oficial baixada de https://www.eve-ng.net/index.php/download/
EVE_ISO=./iso/eve-ng.iso

# Y para ver a linha de comando completa do QEMU nos logs
EVE_DEBUG=N

# --- Rede --------------------------------------------------------------------
# 0.0.0.0   = acessível pelos computadores da sua rede (padrão, necessário
#             em servidor sem interface gráfica). Troque a senha admin/eve
#             no primeiro acesso.
# 127.0.0.1 = acessível só no próprio servidor (só faz sentido com desktop).
# Atenção: portas publicadas pelo Docker passam por cima do ufw.
BIND_ADDR=0.0.0.0

PORT_VIEWER=8006
PORT_HTTP=8080
PORT_HTTPS=8443
PORT_SSH=2222

# Sub-rede da rede Docker. Não use 172.17.0.0/16 nem 172.29.129-130.0/24.
DOCKER_SUBNET=10.250.0.0/24
